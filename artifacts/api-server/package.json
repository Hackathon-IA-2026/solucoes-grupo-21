{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:lambda": "npx --prefix ../../infra esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-lambda/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.699.0",
    "@codegenie/serverless-express": "^4.16.0",
    "@workspace/notification-agent": "workspace:*",
    "@workspace/shared-types": "workspace:*",
    "aws-jwt-verify": "^4.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
